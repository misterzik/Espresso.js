{
    "name": "@misterzik/espressojs",
    "version": "5.0.0",
    "description": "EspressoJS - A modern, plugin-based Express.js framework with optional SSR, MongoDB, and API enhancements. Zero-config startup with enterprise-grade security and complete flexibility.",
    "main": "index.js",
    "scripts": {
        "test": "node test-v4.js && node cli validate",
        "start": "node cli run",
        "start:watch": "nodemon cli run",
        "dev": "node cli env --instance=development --port=8080 && node cli run",
        "dev:watch": "node cli env --instance=development --port=8080 && nodemon cli run",
        "global": "node cli env --instance=global --port=8081 && node cli run",
        "prod": "node cli env --instance=production --port=80 && node cli run",
        "show": "node cli show",
        "validate": "node cli validate",
        "build-dev": "webpack --mode development",
        "build-prod": "webpack --mode production",
        "audit": "npm audit --production",
        "audit:fix": "npm audit fix"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/misterzik/Espresso.js.git"
    },
    "keywords": [
        "espressojs",
        "espresso js",
        "espresso",
        "express",
        "node-express",
        "express-api",
        "express-server",
        "express boilerplate",
        "express",
        "nodejs",
        "ssr",
        "server-side-rendering",
        "api-framework",
        "security",
        "rest-api",
        "graphql",
        "swagger",
        "openapi"
    ],
    "author": "MisterZik",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/misterzik/Espresso.js/issues"
    },
    "homepage": "https://github.com/misterzik/Espresso.js#readme",
    "dependencies": {
        "compression": "^1.7.4",
        "cors": "^2.8.5",
        "dotenv": "^17.4.2",
        "express": "^4.21.1",
        "helmet": "^8.3.0",
        "joi": "^17.13.6",
        "morgan": "^1.11.0",
        "winston": "^3.17.0",
        "yargs": "^17.7.3"
    },
    "peerDependencies": {
        "mongoose": "^8.x || ^9.x",
        "ejs": "^3.x || ^6.x",
        "handlebars": "^4.x",
        "pug": "^3.x",
        "axios": "^1.x",
        "express-rate-limit": "^7.x || ^8.x",
        "express-mongo-sanitize": "^2.x",
        "express-validator": "^7.x",
        "hpp": "^0.2.x",
        "swagger-jsdoc": "^6.x",
        "swagger-ui-express": "^5.x",
        "serve-favicon": "^2.x",
        "serve-static": "^1.x || ^2.x"
    },
    "peerDependenciesMeta": {
        "mongoose": { "optional": true },
        "ejs": { "optional": true },
        "handlebars": { "optional": true },
        "pug": { "optional": true },
        "axios": { "optional": true },
        "express-rate-limit": { "optional": true },
        "express-mongo-sanitize": { "optional": true },
        "express-validator": { "optional": true },
        "hpp": { "optional": true },
        "swagger-jsdoc": { "optional": true },
        "swagger-ui-express": { "optional": true },
        "serve-favicon": { "optional": true },
        "serve-static": { "optional": true }
    },
    "optionalDependencies": {
        "axios": "^1.19.0",
        "ejs": "^3.1.10",
        "express-mongo-sanitize": "^2.2.0",
        "express-rate-limit": "^7.5.1",
        "express-validator": "^7.2.0",
        "handlebars": "^4.7.8",
        "hpp": "^0.2.3",
        "mongoose": "^8.24.2",
        "pug": "^3.0.3",
        "serve-favicon": "^2.5.0",
        "serve-static": "^1.16.3",
        "swagger-jsdoc": "^6.3.0",
        "swagger-ui-express": "^5.0.1"
    },
    "devDependencies": {
        "debug": "^4.3.7",
        "@babel/core": "^7.26.0",
        "@babel/preset-env": "^7.26.0",
        "amd-define-factory-patcher-loader": "^1.0.0",
        "babel-loader": "^9.2.1",
        "nodemon": "^3.1.7",
        "chai": "^5.1.2",
        "mocha": "^11.0.1",
        "supertest": "^7.0.0"
    },
    "engines": {
        "node": ">= 18.0.0",
        "npm": ">= 9.0.0"
    }
}
