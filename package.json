{
    "name": "@misterzik/espressojs",
    "version": "4.0.1",
    "description": "EspressoJS - A modern, secure Express.js boilerplate with SSR support, API enhancements, and plug-and-play configuration. Built for rapid development with security-first approach.",
    "main": "index.js",
    "scripts": {
        "test": "node test-v4.js && node cli validate",
        "start": "node cli run",
        "start:watch": "nodemon cli run",
        "dev": "node cli env --instance=development --port=8080 && node cli run",
        "dev:watch": "node cli env --instance=development --port=8080 && nodemon cli run",
        "global": "node cli env --instance=global --port=8081 && node cli run",
        "prod": "node cli env --instance=production --port=80 && node cli run",
        "show": "node cli show",
        "validate": "node cli validate",
        "build-dev": "webpack --mode development",
        "build-prod": "webpack --mode production",
        "audit": "npm audit --production",
        "audit:fix": "npm audit fix"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/misterzik/Espresso.js.git"
    },
    "keywords": [
        "espressojs",
        "espresso js",
        "espresso",
        "express",
        "node-express",
        "express-api",
        "express-server",
        "express boilerplate",
        "express",
        "nodejs",
        "ssr",
        "server-side-rendering",
        "api-framework",
        "security",
        "rest-api",
        "graphql",
        "swagger",
        "openapi"
    ],
    "author": "MisterZik",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/misterzik/Espresso.js/issues"
    },
    "homepage": "https://github.com/misterzik/Espresso.js#readme",
    "dependencies": {
        "axios": "^1.7.7",
        "compression": "^1.7.4",
        "cors": "^2.8.5",
        "cross-env": "^7.0.3",
        "dotenv": "^16.4.5",
        "ejs": "^3.1.10",
        "express": "^4.21.1",
        "express-mongo-sanitize": "^2.2.0",
        "express-rate-limit": "^7.4.1",
        "express-validator": "^7.2.0",
        "handlebars": "^4.7.8",
        "helmet": "^8.0.0",
        "hpp": "^0.2.3",
        "joi": "^18.2.1",
        "mongoose": "^8.8.3",
        "morgan": "^1.10.0",
        "pug": "^3.0.3",
        "serve-favicon": "^2.5.0",
        "serve-static": "^1.16.2",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1",
        "winston": "^3.17.0",
        "yargs": "^17.7.2"
    },
    "devDependencies": {
        "debug": "^4.3.7",
        "@babel/core": "^7.26.0",
        "@babel/preset-env": "^7.26.0",
        "amd-define-factory-patcher-loader": "^1.0.0",
        "babel-loader": "^9.2.1",
        "nodemon": "^3.1.7"
    },
    "engines": {
        "node": ">= 18.0.0",
        "npm": ">= 9.0.0"
    }
}
